# TRUEMUSTER Environment Variables Template
# Copy to .env.local for local development. Never commit .env or secrets to git!

# Supabase Public API Configuration (Publishable/Anon key only, NEVER service role in clients)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Campus Geofencing Defaults
VITE_CAMPUS_DEFAULT_LAT=19.0760
VITE_CAMPUS_DEFAULT_LNG=72.8777
VITE_GEOFENCE_RADIUS_METRES=100
