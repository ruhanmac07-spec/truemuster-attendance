{
  "name": "truemuster-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TRUEMUSTER — Smart Attendance System Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:student": "npm run dev --workspace=apps/student-android",
    "dev:admin": "npm run dev --workspace=apps/admin-windows",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
